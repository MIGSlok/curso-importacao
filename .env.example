# Copie este arquivo como .env e preencha localmente. Nunca envie segredos ao Git.
NODE_ENV=development
DATABASE_URL=
MERCADOPAGO_MODE=test
PORT=3000
APP_URL=http://localhost:3000
# Configure com o número de proxies confiáveis usado pela hospedagem (ex.: 1).
TRUST_PROXY=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOTP_ENCRYPTION_KEY=
# Token de produção ou de teste do Mercado Pago. Em produção use o token da aplicação certa.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Defina o preço real em reais (por exemplo 49.90); checkout fica indisponível se vazio.
COURSE_PRICE_BRL=
